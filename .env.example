# OpenAI-compatible chat endpoint. Example: https://api.openai.com/v1
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# Required before enabling online chat. Keep server-side and private.
# Generate with a password manager or: openssl rand -hex 32
RATE_LIMIT_SALT=

# Reversible launch defaults
PER_VISITOR_DAILY_LIMIT=5
GLOBAL_DAILY_LIMIT=300
MAX_OUTPUT_TOKENS=300

# EdgeOne Pages KV binding name: ZODIAC_KV
# V0.2 retention metrics require this persistent binding and RATE_LIMIT_SALT.
